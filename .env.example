# ============================================================
# .env.example — Modelo de variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env (ele contém segredos).
# ============================================================


# ================= SERVIDOR =================
PORT=3014
NODE_ENV=development


# ================= EMAIL (Resend) =================
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Remetente (From)
# Em produção, use seu domínio verificado.
# Em desenvolvimento, use onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Luka Lucard Portfólio

# Destinatário (To) — quem recebe as mensagens
EMAIL_TO=seu-email@exemplo.com


# ================= CORS =================
# Origens permitidas, separadas por vírgula (sem espaço)
ALLOWED_ORIGINS=http://localhost:3014,https://seu-site.onrender.com


# ================= RATE LIMIT =================
# Janela em milissegundos (3600000 = 1 hora)
RATE_LIMIT_WINDOW_MS=3600000
# Máximo de requisições por IP dentro da janela
RATE_LIMIT_MAX_REQUESTS=5

# ================= BANCO DE DADOS (Neon) =================
# Obtenha em: https://console.neon.tech
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require